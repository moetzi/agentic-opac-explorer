# ══════════════════════════════════════════════════════════════════════
# Agentic GraphRAG — Environment Configuration Template
# ──────────────────────────────────────────────────────────────────────
# Copy file ini ke `.env` dan isi nilai sesuai environment Anda:
#   cp .env.example .env       (Linux/Mac)
#   copy .env.example .env     (Windows)
#
# JANGAN commit file `.env` ke git (sudah di-ignore).
# ══════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════
# MinIO Configuration
# ──────────────────────────────────────────────────────────────────────
# Object storage untuk data pipeline (Bronze/Silver/Gold layers).
# Default credentials di docker-compose adalah minioadmin/minioadmin.
# ══════════════════════════════════════════════════════════════════════
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_SECURE=False

# Bucket Configuration
MINIO_BUCKET_BRONZE=bronze-opac
MINIO_BUCKET_SILVER=silver-opac
MINIO_BUCKET_GOLD=gold-opac
MINIO_BUCKET_RAW_HTML=raw-html-opac

# ETL Settings
CHUNK_SIZE=5000


# ══════════════════════════════════════════════════════════════════════
# Neo4j Configuration
# ──────────────────────────────────────────────────────────────────────
# Format NEO4J_AUTH: "username/password" (gunakan "/" sebagai separator).
# Pastikan password sama dengan yang ada di docker/docker-compose.yml.
# ══════════════════════════════════════════════════════════════════════
NEO4J_AUTH=neo4j/your_neo4j_password_here
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here


# ══════════════════════════════════════════════════════════════════════
# LLM Provider
# ──────────────────────────────────────────────────────────────────────
# Pilih: "ollama" (lokal) atau "groq" (cloud).
# Ollama gratis & offline, Groq lebih cepat tapi butuh API key.
# ══════════════════════════════════════════════════════════════════════
ACTIVE_LLM_PROVIDER=ollama


# ── Ollama Configuration (GPU remote, BUKAN instance lokal di laptop) ──
# OLLAMA_BASE_URL WAJIB diisi — agent/services/llm_services.py sengaja
# TIDAK punya fallback default, supaya kalau var ini lupa di-set, proses
# gagal eksplisit di awal alih-alih diam-diam kena Ollama lokal (kalau
# kebetulan ada yang jalan di laptop juga). Contoh di bawah asumsi GPU
# remote diakses lewat SSH tunnel ke port lokal 11450 — sesuaikan dengan
# setup Anda (alamat asli host remote kalau tidak pakai tunnel).
# Pastikan model sudah di-pull di sisi server: `ollama pull llama3.1:8b`
OLLAMA_BASE_URL=http://localhost:11450
OLLAMA_MODEL=llama3.1:8b
# Berapa lama Ollama menahan model di memori setelah request terakhir.
OLLAMA_KEEP_ALIVE=10m


# ── Groq Configuration (cloud) ────────────────────────────────────────
# Daftar di https://console.groq.com untuk dapatkan API key.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant


# ── Google Gemini (DeepEval Judge, opsional) ──────────────────────────
# Hanya diperlukan untuk LLM-as-judge evaluation di evaluation/.
# Dapatkan key di https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here


# ══════════════════════════════════════════════════════════════════════
# Embedding Model (Vector Search)
# ──────────────────────────────────────────────────────────────────────
# Default: LazarusNLP/all-indo-e5-small-v4 (384 dim, optimized Bahasa Indo).
# Vector index di Neo4j harus punya dimensi yang sama (384).
# ══════════════════════════════════════════════════════════════════════
EMBEDDING_MODEL=LazarusNLP/all-indo-e5-small-v4
VECTOR_INDEX_NAME=book_vector_index
VECTOR_TOP_K=5
# Jumlah kandidat mentah yang di-over-fetch sebelum dedup-by-title.
VECTOR_TOP_K_RAW=20


# ══════════════════════════════════════════════════════════════════════
# HuggingFace Token
# ──────────────────────────────────────────────────────────────────────
# Diperlukan untuk download model dari HuggingFace Hub.
# Dapatkan di https://huggingface.co/settings/tokens
# ══════════════════════════════════════════════════════════════════════
HF_TOKEN=your_huggingface_token_here


# ══════════════════════════════════════════════════════════════════════
# NGROK Configuration (opsional)
# ──────────────────────────────────────────────────────────────────────
# Untuk tunneling Neo4j Bolt ke public URL (uncomment service di
# docker-compose.yml jika ingin pakai).
# ══════════════════════════════════════════════════════════════════════
# NGROK_AUTHTOKEN=your_ngrok_token_here


# ══════════════════════════════════════════════════════════════════════
# Streamlit Frontend Session Memory & Query Cache (opsional)
# ──────────────────────────────────────────────────────────────────────
# Path file JSON tempat multi-session chat history & query cache disimpan
# agar tetap ada setelah Streamlit di-reload. Kosongkan untuk pakai default:
#   <project_root>/.streamlit_sessions/sessions.json
#   <project_root>/.streamlit_sessions/query_cache.json
# ══════════════════════════════════════════════════════════════════════
AGENTIC_GRAPHRAG_SESSION_STORE=.streamlit_sessions/sessions.json
AGENTIC_GRAPHRAG_QUERY_CACHE=.streamlit_sessions/query_cache.json


# ══════════════════════════════════════════════════════════════════════
# Vanilla JS Web UI (app_web/server.py, opsional)
# ──────────────────────────────────────────────────────────────────────
# Alternatif ringan ke Streamlit — FastAPI + HTML/CSS/JS statis.
# Jalankan: python -m app_web.server
# ══════════════════════════════════════════════════════════════════════
WEB_HOST=127.0.0.1
WEB_PORT=8001
